# Copy to .env on the VPS. Never commit the real .env.

# Absolute host path containing the software projects to analyze.
PROJECTS_DIR=/srv/projects

# Persistent host paths for Hermes and Ollama.
HERMES_DATA_DIR=./data/hermes
HERMES_STATE_DIR=./data/state
OLLAMA_DATA_DIR=./data/ollama

# qwen3.5:9b supports the context needed by Hermes Agent.
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_CONTEXT_LENGTH=65536

# Pin these tags before production after validating an upgrade.
HERMES_IMAGE_TAG=latest
OLLAMA_IMAGE_TAG=latest

# Required. Generate on the VPS: openssl rand -hex 32
API_SERVER_KEY=replace-with-at-least-32-random-bytes
HERMES_API_PORT=8642
API_SERVER_CORS_ORIGINS=http://localhost

# Optional Telegram access. Leave empty when Telegram is disabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Optional cloud fallback. Leave empty for a fully local installation.
OPENROUTER_API_KEY=

# Optional backup destination (S3-compatible storage).
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
