# Copy this file to .env.cloud on the VPS and run chmod 600 .env.cloud.

PROJECTS_DIR=/srv/projects
HERMES_DATA_DIR=./data/hermes-cloud
HERMES_STATE_DIR=./data/state-cloud
HERMES_IMAGE_TAG=latest
HERMES_CONTAINER_UID=10000
HERMES_CONTAINER_GID=10000

# Required: create at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Required: generate on the VPS with: openssl rand -hex 32
API_SERVER_KEY=
HERMES_API_PORT=8642
API_SERVER_CORS_ORIGINS=http://localhost

# Optional Telegram channel. Keep empty until it is configured.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Optional encrypted backup destination.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
